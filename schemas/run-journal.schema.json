{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tekla-harness:schema:run-journal:0.1",
  "title": "Run journal",
  "description": "Written by the Tekla CLI as run-journal-<RUN_ID>.json in the spec's folder, rewritten atomically at every step of a write command (ADR-0012). Records what each invocation of one lot and run created or tagged, so a resumed run never duplicates a SPEC_ID. Strict JSON profile (ADR-0010 A1).",
  "type": "object",
  "required": ["schema_version", "project_id", "lot", "run_id", "spec_file", "spec_sha256", "model_path", "invocations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "project_id": { "$ref": "urn:tekla-harness:schema:common:0.1#/$defs/project_id" },
    "lot": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "run_id": { "$ref": "urn:tekla-harness:schema:common:0.1#/$defs/run_id" },
    "spec_file": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
    "spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model_path": { "type": "string", "minLength": 1, "description": "The working-copy model folder the run writes to." },
    "invocations": {
      "type": "array",
      "description": "One entry per CLI invocation, in execution order.",
      "items": { "$ref": "#/$defs/invocation" }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "invocation": {
      "type": "object",
      "required": ["command", "started_at", "ended_at", "tekla_version", "model_path", "outcome", "exit_code", "committed", "objects", "failure", "conflicts"],
      "additionalProperties": false,
      "properties": {
        "command": { "enum": ["build", "update", "rollback"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "tekla_version": { "type": "string", "minLength": 1 },
        "model_path": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["running", "ok", "stopped", "conflict", "refused", "abandoned"] },
        "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 5 }, { "type": "null" }] },
        "committed": { "type": "boolean" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
        "failure": { "anyOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } }
      }
    },
    "object": {
      "type": "object",
      "required": ["spec_id", "guid", "action", "state"],
      "additionalProperties": false,
      "properties": {
        "spec_id": { "$ref": "urn:tekla-harness:schema:common:0.1#/$defs/spec_id" },
        "guid": { "anyOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] },
        "action": { "enum": ["created", "retagged"] },
        "state": { "enum": ["inserting", "inserted", "tagged"] }
      },
      "if": { "properties": { "state": { "const": "inserting" } } },
      "then": { "properties": { "guid": { "type": "null" } } },
      "else": { "properties": { "guid": { "$ref": "#/$defs/guid" } } }
    },
    "failure": {
      "type": "object",
      "required": ["stage", "spec_id", "error"],
      "additionalProperties": false,
      "properties": {
        "stage": { "enum": ["plan", "insert", "tag", "commit", "journal", "other"] },
        "spec_id": { "anyOf": [{ "$ref": "urn:tekla-harness:schema:common:0.1#/$defs/spec_id" }, { "type": "null" }] },
        "error": { "type": "string", "minLength": 1 }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["kind", "spec_id", "guid", "detail"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mismatch",
            "duplicate_spec_id",
            "spec_id_in_other_run",
            "run_in_other_lot",
            "unknown_spec_id",
            "intent_unresolved",
            "tag_contradiction",
            "unclassified"
          ]
        },
        "spec_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "guid": { "anyOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
